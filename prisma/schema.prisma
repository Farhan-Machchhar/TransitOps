generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DISPATCHER
  MAINTENANCE
  FINANCE
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
  RETIRED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  SUSPENDED
  OFF_DUTY
}

enum TripStatus {
  DRAFT
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(DISPATCHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id              String           @id @default(cuid())
  make            String
  model           String
  type            String           @default("Truck")
  year            Int
  licensePlate    String           @unique
  maxLoadCapacity Float            @default(1000)
  odometer        Float            @default(0)
  acquisitionCost Float            @default(50000)
  status          VehicleStatus    @default(AVAILABLE)
  trips           Trip[]
  maintenanceLogs MaintenanceLog[]
  fuelLogs        FuelLog[]
  expenses        Expense[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Driver {
  id               String       @id @default(cuid())
  firstName        String
  lastName         String
  licenseNumber    String       @unique
  licenseCategory  String       @default("Standard")
  licenseExpiryDate DateTime    @default(now())
  contactNumber    String       @default("000-000-0000")
  safetyScore      Float        @default(100)
  status           DriverStatus @default(AVAILABLE)
  trips            Trip[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Trip {
  id        String     @id @default(cuid())
  vehicleId String
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id])
  driverId  String
  driver    Driver     @relation(fields: [driverId], references: [id])
  status    TripStatus @default(DRAFT)
  origin      String
  destination String
  cargoWeight Float      @default(0)
  plannedDistance Float  @default(0)
  startTime   DateTime?
  endTime     DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MaintenanceLog {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  description String
  cost        Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FuelLog {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  liters    Float
  cost      Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  description String
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
